{
    "name": "goblinq/client",
    "description": "PHP client for the GoblinQ job delivery service",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "GoblinQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GoblinQ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
